# Database
DATABASE_URL=postgresql://oneiro:oneiro_dev@localhost:5432/oneiro_platform

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=oneiro-platform
R2_PUBLIC_URL=

# Resend (email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@oneiro.app

# Google Maps
GOOGLE_MAPS_API_KEY=

# Anthropic (Claude Vision for WO scanning)
ANTHROPIC_API_KEY=

# Encryption key for sensitive fields (tax_id, ssn_last4, OAuth tokens)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Server
PORT=3001
NODE_ENV=development
